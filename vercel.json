{
  "rewrites": [
    {
      "source": "/api/login",
      "destination": "https://tutorneo.mdr-dev.com/login"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tutorneo.mdr-dev.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
